# Скопируйте в .env и при необходимости поменяйте значения.
# Без .env docker compose подставит значения по умолчанию, указанные здесь же.

# --- База данных ---
POSTGRES_DB=benchmark
POSTGRES_USER=benchmark
POSTGRES_PASSWORD=benchmark

# --- Порты, которые стенд занимает на хосте ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
OLLAMA_PORT=11434

# --- Локальная LLM для агента ---
# Чат-модель скачивается автоматически сервисом llm-bootstrap при первом запуске.
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_KEEP_ALIVE=0
AGENT_MAX_TOKENS=384

# --- Фронтенд ---
VITE_API_BASE_URL=http://localhost:8000
# local — модели TensorFlow.js берутся из frontend/public/models (см. scripts/fetch-models.sh)
# cdn   — модели тянутся из официальных CDN Google при первом запуске эксперимента
VITE_MODEL_SOURCE=cdn

CORS_ORIGINS=http://localhost:8080
